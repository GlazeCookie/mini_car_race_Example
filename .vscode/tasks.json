{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Configure",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": ["--preset", "stm32-debug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}" }
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: Build",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": ["--build", "--preset", "stm32-debug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}" }
      },
      "dependsOn": "STM32: Configure",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "STM32: Flash (ST-Link)",
      "type": "process",
      "command": "/opt/homebrew/bin/openocd",
      "args": [
        "-f", "${workspaceFolder}/openocd/stlink-stm32f103.cfg",
        "-c", "program {${workspaceFolder}/build/stm32-debug/micro_smartcar.elf} verify reset exit"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "STM32: Build",
      "problemMatcher": []
    }
  ]
}
